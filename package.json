{
  "name": "brightears",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node --max-old-space-size=2048 ./node_modules/.bin/next build",
    "start": "next start -p ${PORT:-3000} -H 0.0.0.0",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-nobu": "tsx prisma/seed-nobu.ts",
    "test:agency": "tsx --test lib/__tests__/public-artists.test.ts lib/__tests__/public-artist-bio.test.ts lib/__tests__/schedule-calendar.test.ts lib/__tests__/venue-assignment-time.test.ts lib/__tests__/venue-export-scope.test.ts lib/__tests__/conversation-retired.test.ts lib/__tests__/image-runtime.test.ts",
    "test:ai": "tsx --test lib/__tests__/ai-generation*.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "6.39.6",
    "@clerk/themes": "^2.4.13",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/generative-ai": "^0.24.1",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^3.9.1",
    "@line/bot-sdk": "^10.6.0",
    "@line/liff": "^2.26.1",
    "@playwright/test": "^1.55.0",
    "@prisma/client": "^6.19.1",
    "@react-email/components": "^0.5.0",
    "@react-email/render": "^1.2.0",
    "@react-pdf/renderer": "^4.3.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/qrcode": "^1.5.5",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.7.0",
    "clsx": "^2.1.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "next": "15.5.25",
    "next-cloudinary": "^6.16.0",
    "next-intl": "^4.3.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^6.10.1",
    "qrcode": "^1.5.4",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "react-hook-form": "^7.54.2",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "svix": "^1.82.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
